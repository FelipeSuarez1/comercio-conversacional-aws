# Copie para .env (que NÃO vai para o git):  cp .env.example .env
# Usado pelo docker compose no ambiente local.

# fake = respostas simuladas, sem chamar o provedor (não precisa de chave)
# real = chama o LLM de verdade usando as variáveis abaixo
LLM_MODO=fake

# Chave da API do provedor. Deixe vazia no modo fake. Nunca commite a chave.
LLM_API_KEY=

# URL base de qualquer API compatível com o formato OpenAI de chat completions
LLM_BASE_URL=https://api.exemplo-de-provedor.com/v1

# Id do modelo no provedor escolhido
MODEL_ID=nome-do-modelo

# Opcional: nível de log dos serviços (padrão INFO)
# LOG_LEVEL=DEBUG
