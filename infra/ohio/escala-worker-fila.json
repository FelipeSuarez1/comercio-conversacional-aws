{
  "TargetValue": 100.0,
  "CustomizedMetricSpecification": {
    "Metrics": [
      {
        "Id": "visiveis",
        "MetricStat": {
          "Metric": {
            "Namespace": "AWS/SQS",
            "MetricName": "ApproximateNumberOfMessagesVisible",
            "Dimensions": [{ "Name": "QueueName", "Value": "__PREFIXO__-pedidos" }]
          },
          "Stat": "Sum"
        },
        "ReturnData": false
      },
      {
        "Id": "tasks",
        "MetricStat": {
          "Metric": {
            "Namespace": "ECS/ContainerInsights",
            "MetricName": "RunningTaskCount",
            "Dimensions": [
              { "Name": "ClusterName", "Value": "__PREFIXO__-cluster" },
              { "Name": "ServiceName", "Value": "__PREFIXO__-order-worker" }
            ]
          },
          "Stat": "Average"
        },
        "ReturnData": false
      },
      {
        "Id": "backlog_por_task",
        "Expression": "visiveis / tasks",
        "Label": "Mensagens na fila por task do worker",
        "ReturnData": true
      }
    ]
  },
  "ScaleOutCooldown": 60,
  "ScaleInCooldown": 120,
  "DisableScaleIn": false
}
